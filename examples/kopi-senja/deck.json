    {
      "type": "understanding_brand",
      "title": "Busy at 8am. Empty by 5pm.",
      "body": "Kopi Senja (fictional) runs 12 neighbourhood outlets. Mornings are a commuter rush; the afternoon is quiet even though the brand is literally named after dusk. The name is an unused asset.",
      "points": [
        "Morning traffic is price-driven and loyal to whoever is closest",
        "Afternoons compete with malls, gyms and the commute home",
        "The name 'senja' (dusk) already carries a feeling people post about",
        "Goal: make 4–7pm a reason to visit, not a gap to fill with discounts"
      ]
    },
    {
      "type": "big_idea",
      "idea_name": "Golden Hour Club",
      "tagline": "The best part of the day starts when work ends.",
      "narrative": "We reposition Kopi Senja from a commuter pit-stop to the city's after-work ritual. Every outlet becomes a 'golden hour' spot: warm light, a dusk-only menu, and creators who make 5pm the moment you look forward to.",
      "hook": "Clock out, glow up — see you at Senja."
    },
    {
      "type": "storyline",
      "arc_label": "6 weeks, 4 beats",
      "beats": [
        {
          "name": "Tease",
          "what": "Creators post their 'unplanned 5pm' — sunsets, commutes, the itch to stop somewhere.",
          "feeling": "That's me."
        },
        {
          "name": "Reveal",
          "what": "Golden Hour Club launches: dusk-only menu, warm-light corners, a stamp card that only works after 4pm.",
          "feeling": "Wait, where is that?"
        },
        {
          "name": "Ritual",
          "what": "Weekly creator meet-ups and 'clock-out' playlists turn visits into a habit.",
          "feeling": "This is my spot."
        },
        {
          "name": "Belong",
          "what": "Regulars' stories become the content; the best ones get their own drink named after them.",
          "feeling": "I'm part of this."
        }
      ]
    },
    {
      "type": "strategic_approach",
      "framework": "Tease → Launch → Sustain",
      "pillars": [
        {
          "label": "Own a time slot",
          "desc": "Every asset says 4–7pm. We sell a moment, not a menu."
        },
        {
          "label": "Creators as regulars",
          "desc": "Micro creators who live near outlets post repeatedly, not once — repetition builds the ritual."
        },
        {
          "label": "Make it physical",
          "desc": "Light, playlist and stamp card make the idea visible in-store, so content and reality match."
        }
      ]
    },
